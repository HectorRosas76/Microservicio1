### Hello word
get http://127.0.0.1:8000/

### Consultar todos los clientes
get http://127.0.0.1:8081/clientes

### Consultar un cliente
get http://127.0.0.1:8081/clientes/1

### registrar un cliente
POST http://127.0.0.1:8081/clientes
Content-Type: application/json

{
    "nombre": "John Doe",
    "telefono": "1234567890",
        "correo": "john.doe@test.com",
        "numero_licencia": "ABC123456"
}

### modificar un cliente
PUT http://127.0.0.1:8081/clientes/1
Content-Type: application/json

{
    "nombre": "John Doe",
    "telefono": "34567890",
        "correo": "john.moe@test.com",
        "numero_licencia": "ABC123436"
}

### borrar un cliente
DELETE http://127.0.0.1:8081/clientes/1

//////////////////////////////////////////////////////

### Consultar todos los vehículos
get http://127.0.0.1:8061/vehiculos

### Consultar un vehículo
get http://127.0.0.1:8061/vehiculos/1

### registrar un vehículo
POST http://127.0.0.1:8061/vehiculos
Content-Type: application/json

{
    "marca": "Toyota",
    "modelo": "Camry",
    "anio": 2020,
    "categoria": "Escape",
    "estado": "disponible"
}

### modificar un vehículo
PUT http://127.0.0.1:8061/vehiculos/1
Content-Type: application/json

{
    "marca": "Toyota",
    "modelo": "Camry",
    "anio": 2021,
    "categoria": "4X4",
    "estado": "alquilado"
}

### borrar un vehículo
DELETE http://127.0.0.1:8061/vehiculos/1



/////////////////////////////////////////////


### (vehiculos_ms) Cambiar solo el estado de un vehículo
PATCH http://127.0.0.1:8061/vehiculos/1/estado
Content-Type: application/json

{
    "estado": "disponible"
}
